---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArchitectureFlow from '../components/ArchitectureFlow.astro';
const github='https://github.com/LuizJesus01';
const linkedin='https://www.linkedin.com/in/luiz-jesus-239101132/';
const projects=[
 {n:'01 / FEATURED',title:'Olist — Modern Analytics Platform',sub:'Azure · Snowflake · dbt · Airflow',flow:['Olist/Kaggle','ADLS Gen2','ADF','Snowflake','dbt','Airflow','Power BI'],summary:'Plataforma analítica end-to-end de e-commerce com ingestão de múltiplos formatos, transformação em camadas, modelagem dimensional, qualidade automatizada, governança e orquestração.',tags:['18 modelos dbt','9 sources','100 testes','Medallion','Dimensional Modeling','RBAC','Masking','Row Access Policy','Lineage'],case:'/projetos/olist',repo:'https://github.com/LuizJesus01/Olist-Analytics-Modern-Data-Platform-Azure-Snowflake-dbt'},
 {n:'02',title:'Fraud Detection Data Platform',sub:'GCP · BigQuery · dbt · Airflow',flow:['CSV / JSON','GCS','Airflow','BigQuery RAW','dbt','Marts / Gold','Power BI'],summary:'Case de plataforma de dados para sinais analíticos de risco de fraude e performance de afiliados, com ingestão de fontes heterogêneas, transformação em camadas e Data Quality.',tags:['BigQuery','Staging','Intermediate','Marts','20 dbt tests','Explicit schemas','Airflow','Fraud Analytics'],case:'/projetos/fraud-detection',repo:'https://github.com/LuizJesus01/Fraud-Detection-Data-Platform-GCP'},
 {n:'03',title:'Real-Time Data & AI Platform',sub:'Data Engineering for AI',status:'EM DESENVOLVIMENTO',flow:['Python Producer','Kafka','Spark Streaming','Lakehouse','Vector DB','RAG','LLM'],summary:'Próxima etapa da evolução técnica: uma plataforma de dados em tempo real preparada para fornecer dados confiáveis a aplicações de IA, sem deslocar o foco de Data Engineering.',tags:['Streaming','Terraform / IaC','CI/CD','Data Contracts','Observability','Embeddings','RAG']}
];
---
<BaseLayout><Header/><main id="main">
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Senior Data Engineer</p><h1>Engenheiro de Dados <span>Sênior</span></h1><p class="hero-lead">Construindo plataformas modernas de dados, da ingestão ao analytics.</p><p class="hero-context">12+ anos construindo soluções de dados, com uma trajetória que evoluiu de Oracle, ETL e Data Warehouse para Cloud, Lakehouse e Modern Data Engineering.</p><div class="tags hero-tags">{['SQL','ETL','AWS','Databricks','PySpark','Lakehouse'].map(x=><span class="tag">{x}</span>)}</div><div class="actions"><a class="button primary" href="#projetos">Ver projetos de engenharia</a><a class="button secondary" href={github} target="_blank">GitHub ↗</a><a class="button secondary" href={linkedin} target="_blank">LinkedIn ↗</a></div></div><div class="system card"><div class="syshead"><span class="mono">DATA PLATFORM</span><i></i></div><div class="sysbody">{['Sources','Ingestion','Transformation','Quality & Governance','Analytics'].map((x,i)=><><div><span class="mono">0{i+1}</span><strong>{x}</strong></div>{i<4&&<b></b>}</>)}</div><div class="sysfoot mono">reliable · governed · observable</div></div></div></section>
<section class="section"><div class="container"><p class="eyebrow">Evolução profissional</p><h2 class="section-title">Uma carreira que evoluiu junto com a Engenharia de Dados.</h2><p class="quote">“Minha carreira não começou na Engenharia de Dados moderna; ela evoluiu até ela.”</p><div class="timeline">{[['01','Oracle · ETL · DW','SQL, PL/SQL, ODI, modelagem, integração e performance.'],['02','Cloud · Lakehouse','AWS, Databricks, PySpark, Spark, OCI e arquitetura distribuída.'],['03','Modern Data Engineering','dbt, orchestration, Data Quality, Governance e observability.'],['04','Data Engineering for AI','Streaming, Data Contracts, Vector DB, embeddings, RAG e pipelines para aplicações com LLMs.']].map((x,i)=><><article class={i===3?'future':''}><div class="stephead"><span class="mono">{x[0]}</span>{i===3&&<em class="mono">EM EVOLUÇÃO</em>}</div><h3>{x[1]}</h3><p>{x[2]}</p></article>{i<3&&<div class="tarrow">→</div>}</>)}</div></div></section>
<section class="section" id="projetos"><div class="container"><p class="eyebrow">Featured Engineering Projects</p><h2 class="section-title">Plataformas construídas para demonstrar decisões de engenharia.</h2><p class="section-intro">Arquitetura, qualidade, governança, confiabilidade e implementação — com o GitHub como evidência técnica.</p><div class="project-list">{projects.map((p,i)=><article class:list={['project card',{featured:i===0}]}><div class="ptop"><span class="mono">{p.n}</span>{p.status&&<em class="mono">{p.status}</em>}</div><p class="eyebrow">{p.sub}</p><h3>{p.title}</h3><p class="summary">{p.summary}</p><div class="flowwrap"><ArchitectureFlow items={p.flow}/></div><div class="tags">{p.tags.map(t=><span class="tag">{t}</span>)}</div><div class="actions">{p.case&&<a class="button primary" href={p.case}>Explorar Case Study →</a>}{p.repo&&<a class="button secondary" href={p.repo} target="_blank">GitHub ↗</a>}</div></article>)}</div></div></section>
<section class="section" id="engenharia"><div class="container"><p class="eyebrow">Engineering Focus</p><h2 class="section-title">Problemas de engenharia que resolvo.</h2><div class="focus-grid">{[['Data Platforms','Desenho e construção de pipelines e plataformas desde a ingestão até as camadas analíticas.'],['Data Modeling','Modelagem dimensional, Data Warehouse e estruturas orientadas ao consumo analítico.'],['Data Quality & Reliability','Testes automatizados, integridade, reconciliação, troubleshooting e confiabilidade.'],['Performance & Troubleshooting','Diagnóstico de gargalos, otimização SQL e investigação de falhas em pipelines e plataformas.'],['Governance','RBAC, políticas de acesso, masking, lineage e controles aplicados ao ciclo de dados.'],['Cloud & Lakehouse','Arquiteturas modernas em cloud, processamento distribuído e padrões Lakehouse.']].map((x,i)=><article class="focus card"><span class="mono">0{i+1}</span><h3>{x[0]}</h3><p>{x[1]}</p></article>)}</div></div></section>
<section class="section"><div class="container"><p class="eyebrow">Professional Foundation</p><h2 class="section-title">12+ anos construindo soluções de dados.</h2><div class="foundation"><article class="card"><span class="mono label">BASE PROFISSIONAL</span><h3>Fundação técnica construída ao longo da carreira.</h3><div class="tags">{['SQL','Oracle','PL/SQL','ODI','ETL','Data Warehouse','Modelagem','Performance'].map(x=><span class="tag">{x}</span>)}</div></article><article class="card"><span class="mono label">EVOLUÇÃO PROFISSIONAL</span><h3>Cloud, processamento distribuído e Lakehouse.</h3><div class="tags">{['AWS','Databricks','PySpark / Spark','Lakehouse','OCI'].map(x=><span class="tag">{x}</span>)}</div></article><article class="card hands"><span class="mono label">PROJETOS & HANDS-ON</span><h3>Tecnologias demonstradas em projetos de engenharia.</h3><div class="tags">{['Azure','ADLS Gen2','ADF','Snowflake','dbt','GCP','BigQuery','Airflow','Data Quality','Governance','Lineage','Power BI'].map(x=><span class="tag">{x}</span>)}</div><p class="scope-note">O portfólio distingue experiência profissional de implementações realizadas em projetos técnicos.</p></article></div></div></section>
<section class="section final"><div class="container"><div class="cta card"><p class="eyebrow">Evidence over claims</p><h2>Explore a implementação.</h2><p>Os Case Studies apresentam as decisões de engenharia. Os repositórios apresentam a implementação.</p><div class="actions"><a class="button primary" href={github} target="_blank">Explorar GitHub ↗</a><a class="button secondary" href={linkedin} target="_blank">LinkedIn ↗</a></div></div></div></section>
</main><Footer/></BaseLayout>
<style>
.hero{padding:96px 0 112px;min-height:calc(100vh - 70px);display:flex;align-items:center}.hero-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(340px,.7fr);gap:70px;align-items:center}.hero h1{margin:0;font-size:clamp(3.2rem,7vw,6.3rem);line-height:.92;letter-spacing:-.065em;max-width:820px}.hero h1 span{color:var(--accent)}.hero-lead{font-size:clamp(1.25rem,2.1vw,1.75rem);line-height:1.35;max-width:720px;margin:28px 0 0}.hero-context{color:var(--muted);max-width:720px;margin:18px 0 0}.hero-tags{margin-top:28px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.system{padding:22px;min-height:450px;display:flex;flex-direction:column}.syshead{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px;color:var(--muted);font-size:.74rem;letter-spacing:.12em}.syshead i{width:8px;height:8px;border-radius:50%;background:#8de3b6}.sysbody{padding:28px 0;display:flex;flex-direction:column;flex:1}.sysbody div{display:flex;align-items:center;gap:18px}.sysbody div span{color:var(--faint);font-size:.72rem;width:22px}.sysbody div strong{font-size:.92rem}.sysbody b{width:1px;height:30px;background:linear-gradient(var(--accent),rgba(101,217,255,.12));margin:4px 0 4px 10px}.sysfoot{border-top:1px solid var(--line);padding-top:14px;color:var(--faint);font-size:.7rem}.quote{color:#c6d6df;font-size:1.12rem;margin:25px 0 50px}.timeline{display:grid;grid-template-columns:repeat(7,auto);align-items:stretch;gap:14px}.timeline article{border-top:1px solid var(--line);padding:22px 6px 0;min-width:0}.timeline article>div>span{color:var(--accent);font-size:.72rem}.timeline h3{font-size:1.1rem;margin:18px 0 8px}.timeline p{color:var(--muted);font-size:.9rem;margin:0}.tarrow{color:var(--accent);display:grid;place-items:center}.future{background:linear-gradient(180deg,var(--soft),transparent);border-radius:12px;padding-left:16px!important;padding-right:16px!important}.stephead{display:flex;justify-content:space-between;gap:8px}.stephead em,.ptop em{font-style:normal;color:var(--accent);border:1px solid rgba(101,217,255,.25);padding:5px 8px;border-radius:999px;font-size:.62rem}.project-list{display:grid;gap:22px;margin-top:44px}.project{padding:30px}.project.featured{padding:38px}.ptop{display:flex;justify-content:space-between;align-items:center;color:var(--faint);font-size:.78rem}.project>.eyebrow{margin-top:40px}.project h3{margin:0;font-size:clamp(1.8rem,4vw,3rem);line-height:1.08;letter-spacing:-.035em}.summary{color:var(--muted);max-width:740px}.flowwrap{padding:26px 0;margin:28px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.focus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}.focus{padding:24px;min-height:220px}.focus>span,.label{color:var(--accent);font-size:.7rem}.focus h3{margin:34px 0 10px;font-size:1.22rem}.focus p{margin:0;color:var(--muted);font-size:.92rem}.foundation{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:44px}.foundation article{padding:28px}.foundation h3{margin:24px 0 22px}.hands{grid-column:1/-1}.hands .scope-note{margin-top:24px;max-width:760px}.final{padding-bottom:110px}.cta{padding:50px}.cta h2{font-size:clamp(2.2rem,5vw,4.5rem);margin:0;letter-spacing:-.05em}.cta>p:not(.eyebrow){color:var(--muted);max-width:650px}@media(max-width:980px){.hero-grid{grid-template-columns:1fr;gap:50px}.hero{min-height:auto}.system{min-height:auto}.timeline{grid-template-columns:1fr}.tarrow{transform:rotate(90deg)}.focus-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.hero{padding:72px 0 80px}.focus-grid,.foundation{grid-template-columns:1fr}.hands{grid-column:auto}.project,.project.featured{padding:22px}.cta{padding:28px}}
</style>
