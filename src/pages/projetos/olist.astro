import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
const repo='https://github.com/LuizJesus01/Olist-Analytics-Modern-Data-Platform-Azure-Snowflake-dbt';
---
<BaseLayout title="Olist — Modern Analytics Platform | Luiz Jesus" description="Case Study de Engenharia de Dados com Azure, Snowflake, dbt, Airflow, governança, Data Quality e Power BI." canonicalPath="/projetos/olist"><CaseStudyLayout number="01" title="Olist — Modern Analytics Platform" kicker="Azure · Snowflake · dbt · Airflow · Power BI" description="Plataforma moderna de dados construída sobre o dataset público da Olist, cobrindo ingestão, transformação, qualidade, governança, orquestração e consumo analítico." repo={repo} flow={['Olist / Kaggle','Python','ADLS Gen2','Azure Data Factory','Snowflake RAW','dbt Silver','dbt Gold','Power BI']} metrics={[{value:'18',label:'MODELOS DBT'},{value:'9',label:'SOURCES'},{value:'100',label:'TESTES DBT'}]} stack={['Azure','ADLS Gen2','ADF','Snowflake','dbt Core','Airflow / Astro','Power BI','GitHub']} problem={['Construir uma plataforma analítica de e-commerce capaz de receber fontes em diferentes formatos e entregar uma camada de dados confiável para consumo analítico.','Além de fazer a carga funcionar, a solução precisava demonstrar separação por camadas, qualidade automatizada, modelagem dimensional, governança, rastreabilidade e orquestração end-to-end.']} decisions={[
{title:'Separar ingestão, transformação e consumo por responsabilidade',context:'A plataforma recebe dados de origem heterogênea e precisa evitar acoplamento entre landing, tratamento e regras analíticas.',decision:'ADLS como landing zone, ADF para integração, Snowflake como engine analítica e dbt para transformação.',why:'Mantém responsabilidades claras e permite validar cada estágio de forma independente.',tradeoff:'Mais componentes exigem configuração e observabilidade entre serviços, mas tornam o fluxo mais explícito e governável.'},
{title:'Silver para preparação; Gold para modelo dimensional',context:'Dados RAW não estavam prontos para consumo e possuíam diferenças de formato, tipos e cardinalidade.',decision:'Staging/Silver para padronização e tipagem; Gold para dimensões e fatos.',why:'Evita misturar limpeza técnica com lógica de negócio e fornece uma camada estável para analytics.',tradeoff:'Cria mais modelos e dependências, compensados por rastreabilidade e testes automatizados.'},
{title:'Data Quality como etapa do pipeline',context:'Problemas em chaves, relacionamento e granularidade podem propagar dados incorretos até o BI.',decision:'Aplicar testes dbt e validações de cardinalidade, integridade e reconciliação antes de considerar a transformação concluída.',why:'Transforma qualidade de dados em comportamento verificável, não em checagem manual eventual.',tradeoff:'Aumenta tempo de execução e manutenção de testes, mas reduz risco de consumo silencioso de dados inconsistentes.'},
{title:'Governança aplicada na plataforma',context:'Um Data Warehouse analítico deve controlar acesso e exposição de dados, mesmo em um case técnico.',decision:'Demonstrar RBAC, Dynamic Data Masking, Row Access Policy, Tags, Resource Monitor e Time Travel.',why:'Mostra que arquitetura de dados inclui segurança, custo e recuperação — não apenas transformação.',tradeoff:'Adiciona objetos e configuração administrativa que precisam ser documentados e testados.'}
]} challenges={[{title:'JSON single-line',text:'A leitura inicial dos objetos JSON exigiu ajustar a forma de extração dos campos Variant para eliminar valores nulos no staging.'},{title:'CSV e mapping',text:'Headers, delimitadores e um caractere CR em um campo de tradução causaram problemas de mapeamento durante a ingestão.'},{title:'Cardinalidade',text:'Itens, pagamentos e reviews possuíam multiplicidades diferentes, exigindo análise de grain antes da modelagem.'},{title:'Orquestração end-to-end',text:'A DAG precisou coordenar ingestão Python, execução do ADF, espera da carga e só então dbt run/test em comportamento fail-fast.'}]} reliability={['100 testes dbt executados com sucesso.','Testes de not_null, unique, relationships e combinações de colunas.','Validações de granularidade, cardinalidade e reconciliação financeira.','RBAC, Dynamic Data Masking, Row Access Policy e Tags no Snowflake.','Resource Monitor e warehouses separados para workloads.','Laboratório de recuperação com Snowflake Time Travel.','Data Lineage via dbt Docs.','Airflow/Astro coordenando dependências do pipeline em fail-fast.']} images={[{src:'https://raw.githubusercontent.com/LuizJesus01/Olist-Analytics-Modern-Data-Platform-Azure-Snowflake-dbt/main/docs/images/dbt_lineage.png',alt:'Lineage do projeto Olist gerado pelo dbt Docs',caption:'dbt Docs — dependências entre sources, staging e Gold.'}]} results={['Pipeline end-to-end reproduzível desde a origem até o Power BI.','Modelo analítico organizado em Silver e Gold.','Camada de qualidade automatizada integrada ao fluxo.','Controles de governança e segurança demonstrados no Snowflake.','Orquestração automatizada com Airflow / Astro.','GitHub organizado como evidência técnica da implementação.']} note="Este é um projeto prático de Engenharia de Dados. A experiência demonstrada no projeto é apresentada separadamente da experiência profissional acumulada ao longo da carreira."/></BaseLayout>
