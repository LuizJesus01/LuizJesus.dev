---
import Header from './Header.astro';
import Footer from './Footer.astro';
import ArchitectureFlow from './ArchitectureFlow.astro';
const {number,title,kicker,description,repo,flow,metrics,stack,problem,decisions,challenges,reliability,results,note,images=[]}=Astro.props;
---
<Header/><main id="main"><section class="case-hero"><div class="container"><a class="back mono" href="/#projetos">← Voltar aos projetos</a><p class="eyebrow">{number} / Case Study</p><h1>{title}</h1><p class="kicker">{kicker}</p><p class="description">{description}</p><a class="button primary gh" href={repo} target="_blank">Ver código no GitHub ↗</a><div class="metrics">{metrics.map(m=><div><strong>{m.value}</strong><span class="mono">{m.label}</span></div>)}</div></div></section><div class="container shell"><aside><span class="mono">CASE INDEX</span><nav>{[['01','Problema'],['02','Arquitetura'],['03','Decisões'],['04','Desafios'],['05','Governança & Confiabilidade'],['06','Resultados'],['07','Código']].map(x=><a href={`#s${x[0]}`}>{x[0]} — {x[1]}</a>)}</nav></aside><article class="content">
<section id="s01" class="case-section"><p class="eyebrow">01 — Problem</p><h2>Problema de engenharia</h2>{problem.map(p=><p>{p}</p>)}</section>
<section id="s02" class="case-section"><p class="eyebrow">02 — Architecture</p><h2>Arquitetura</h2><div class="arch card"><ArchitectureFlow items={flow}/></div><div class="tags">{stack.map(x=><span class="tag">{x}</span>)}</div></section>
<section id="s03" class="case-section"><p class="eyebrow">03 — Engineering Decisions</p><h2>Decisões de engenharia</h2><div class="decisions">{decisions.map((d,i)=><article class="decision card"><span class="mono">DECISION {String(i+1).padStart(2,'0')}</span><h3>{d.title}</h3><dl><div><dt>Context</dt><dd>{d.context}</dd></div><div><dt>Decision</dt><dd>{d.decision}</dd></div><div><dt>Why</dt><dd>{d.why}</dd></div><div><dt>Trade-off</dt><dd>{d.tradeoff}</dd></div></dl></article>)}</div></section>
<section id="s04" class="case-section"><p class="eyebrow">04 — Challenges & Trade-offs</p><h2>Desafios encontrados</h2><div class="challenge-grid">{challenges.map((c,i)=><article><span class="mono">0{i+1}</span><h3>{c.title}</h3><p>{c.text}</p></article>)}</div></section>
<section id="s05" class="case-section"><p class="eyebrow">05 — Governance & Reliability</p><h2>Confiabilidade e controles</h2><ul>{reliability.map(x=><li>{x}</li>)}</ul></section>
{images.length>0&&<section class="case-section"><p class="eyebrow">Technical Evidence</p><h2>Evidência visual</h2><div class="image-grid">{images.map(img=><figure class="card"><img src={img.src} alt={img.alt} loading="lazy"/><figcaption>{img.caption}</figcaption></figure>)}</div></section>}
<section id="s06" class="case-section"><p class="eyebrow">06 — Results</p><h2>Resultado</h2><ul>{results.map(x=><li>{x}</li>)}</ul>{note&&<p class="scope-note">{note}</p>}</section>
<section id="s07" class="case-section"><p class="eyebrow">07 — Source Code</p><h2>Veja a implementação.</h2><p>O Case Study explica as decisões. O GitHub apresenta o código, os modelos e os artefatos técnicos.</p><a class="button primary" href={repo} target="_blank">Abrir repositório ↗</a></section>
</article></div></main><Footer/>
<style>.case-hero{padding:80px 0 68px;border-bottom:1px solid var(--line)}.back{display:inline-block;color:var(--muted);font-size:.76rem;margin-bottom:54px}.case-hero h1{margin:0;max-width:950px;font-size:clamp(3rem,7vw,6rem);line-height:.96;letter-spacing:-.06em}.kicker{color:var(--accent);font-size:1.15rem;font-weight:650;margin:24px 0 0}.description{max-width:760px;color:var(--muted);font-size:1.04rem;margin:14px 0 0}.gh{margin-top:28px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:60px}.metrics div{background:var(--bg);padding:24px}.metrics strong{display:block;font-size:2rem}.metrics span{color:var(--muted);font-size:.72rem}.shell{display:grid;grid-template-columns:240px minmax(0,1fr);gap:72px;padding-top:80px;padding-bottom:100px}.shell aside{position:sticky;top:100px;align-self:start}.shell aside>span{color:var(--faint);font-size:.7rem}.shell aside nav{display:flex;flex-direction:column;margin-top:18px}.shell aside a{padding:9px 0;color:var(--muted);font-size:.82rem;border-bottom:1px solid var(--line)}.case-section{padding:16px 0 84px;scroll-margin-top:90px}.case-section+.case-section{border-top:1px solid var(--line);padding-top:80px}.case-section h2{font-size:clamp(2rem,4vw,3.4rem);line-height:1.05;letter-spacing:-.045em;margin:0 0 28px}.case-section>p:not(.eyebrow,.scope-note){color:var(--muted);max-width:780px}.arch{padding:30px;margin:28px 0 20px}.decisions{display:grid;gap:14px}.decision{padding:30px}.decision>span,.challenge-grid span{color:var(--accent);font-size:.7rem}.decision h3{margin:18px 0 24px;font-size:1.45rem}.decision dl{display:grid;grid-template-columns:1fr 1fr;margin:0;border-top:1px solid var(--line)}.decision dl div{padding:18px 0;border-bottom:1px solid var(--line)}.decision dl div:nth-child(odd){padding-right:24px}.decision dl div:nth-child(even){padding-left:24px;border-left:1px solid var(--line)}dt{font-family:var(--mono);text-transform:uppercase;color:var(--faint);font-size:.68rem;margin-bottom:7px}dd{margin:0;color:#c7d6df;font-size:.9rem}.challenge-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.challenge-grid article{padding:24px 0;border-top:1px solid var(--line)}.challenge-grid h3{margin:18px 0 8px}.challenge-grid p{margin:0;color:var(--muted);font-size:.9rem}.case-section ul{list-style:none;padding:0;display:grid;gap:10px}.case-section li{position:relative;padding:16px 18px 16px 46px;border:1px solid var(--line);border-radius:10px;color:#c8d8e1}.case-section li:before{content:'✓';position:absolute;left:18px;color:var(--accent);font-family:var(--mono)}.image-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.image-grid figure{margin:0;overflow:hidden}.image-grid img{width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff}.image-grid figcaption{padding:14px 16px;color:var(--muted);font-size:.8rem;border-top:1px solid var(--line)}@media(max-width:900px){.shell{grid-template-columns:1fr;gap:0}.shell aside{display:none}}@media(max-width:700px){.metrics{grid-template-columns:1fr}.decision dl{grid-template-columns:1fr}.decision dl div:nth-child(odd),.decision dl div:nth-child(even){padding:16px 0;border-left:0}.challenge-grid,.image-grid{grid-template-columns:1fr}}</style>
